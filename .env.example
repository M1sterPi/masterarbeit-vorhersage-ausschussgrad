# Vorlage: als .env kopieren und ausfüllen. .env ist von git ausgeschlossen.

# Ordner der Rohkurven je Billet (billet_<nr>.csv)
KURVEN_DIR=

# InfluxDB, nur für den Datenexport (merge_billetv2.py, arc_end_scan.py)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=

# ERP-Exporte für convert_sql_db.py, neuester zuerst, mit ";" getrennt
SQL_EXPORTS=

# Billetnummer für das Beispiel in eda/32
BEISPIEL_BILLET=
